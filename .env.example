# Copy to .env.local and fill in your own key. Never commit real keys.

# Google AI Studio API key with access to the Gemma 4 models.
# Get one at https://aistudio.google.com/apikey
GEMMA_API_KEY=your_gemma_api_key_here

# Gemma 4 model id. Options seen on the Gemini API:
#   gemma-4-31b-it      (default — best question/feedback quality)
#   gemma-4-26b-a4b-it  (faster MoE variant, lower quality)
GEMMA_MODEL=gemma-4-31b-it
